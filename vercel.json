{
  "framework": null,
  "buildCommand": "echo 'Serving static navigation data'",
  "outputDirectory": "public",
  "headers": [
    {"source": "/navdata/(.*)", "headers": [
      {"key": "Access-Control-Allow-Origin", "value": "*"},
      {"key": "Cache-Control", "value": "public, max-age=300"}
    ]}
  ]
}
